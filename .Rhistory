renv::init(bare = TRUE)
quit()
installed.packages()
renv::install('tidyverse')
renv::install('languageserver')
renv::install(c('knitr', 'rmarkdown'))
renv::snapshot()
renv::status()
quit()
install.packages(c('renv', 'languageserver', 'reticulate'))
renv::init()
renv::status()
renv::snapshot()
installed.packages()
quit()
