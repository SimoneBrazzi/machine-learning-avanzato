      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import statsmodels.api as sm\n",
        "\n",
        "from skforecast.datasets import fetch_dataset\n",
        "\n",
        "df = fetch_dataset(name='fuel_consumption', raw=True)\n",
        "df = df[['Fecha', 'Gasolinas']]\n",
        "df['date'] = pd.to_datetime(df.Fecha)\n",
        "ts = df.set_index('date')['Gasolinas']\n",
        "ts"
      ],
      "id": "8803d74a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, ax = plt.subplots(figsize=(12, 10))\n",
        "ax.plot(ts.index, ts)\n",
        "plt.show()"
      ],
      "id": "defd84cd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### EDA\n",
        "\n",
        "#### Trend"
      ],
      "id": "c316f137"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from statsmodels.tsa.stattools import adfuller\n",
        "\n",
        "def adf_test(x):\n",
        "\n",
        "  result = adfuller(x)\n",
        "\n",
        "  if result[1] <= 0.05:\n",
        "    print(f\"Reject H0: Time series is STATIONARY\")\n",
        "  else:\n",
        "    print(\"Failed to reject H0: Time series is NON-STATIONARY\")\n",
        "\n",
        "  return result\n",
        "\n",
        "adf_test(ts)"
      ],
      "id": "153eb7a3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "adf_test(ts.diff().dropna())"
      ],
      "id": "4b24de06",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, ax = plt.subplots(1, 2, figsize=(12, 10))\n",
        "ax[0].plot(np.log(ts).diff(1).diff(12).dropna(), label=\"Log and diff\", color=\"red\")\n",
        "ax[1].plot(ts.index, ts, label='Original')\n",
        "ax[0].legend()\n",
        "ax[1].legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "95e1c608",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "adf_test(np.log(ts).diff(1).diff(12).dropna())"
      ],
      "id": "8081f549",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from scipy.stats import boxcox\n",
        "\n",
        "transformed, lmbda = boxcox(ts)\n",
        "\n",
        "ts_lambda = ts.copy()\n",
        "ts_lambda.iloc[:] = transformed"
      ],
      "id": "65a3d57c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, ax = plt.subplots(3, 1, figsize=(12, 10))\n",
        "ax[0].plot(np.log(ts).diff(1).diff(12).dropna(), label=\"Log and diff\", color=\"red\")\n",
        "ax[1].plot(ts_lambda.diff(1).diff(12).dropna(), label=\"transformed lambda 0.75\", color=\"green\")\n",
        "ax[2].plot(ts.index, ts, label='Original')\n",
        "ax[0].legend()\n",
        "ax[1].legend()\n",
        "ax[2].legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "58f7649e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### Models\n"
      ],
      "id": "4d464386"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n",
        "\n",
        "fig, ax = plt.subplots(4, 1, figsize=(12, 10))\n",
        "ax[0].plot(ts.index, ts, label=\"Original\")\n",
        "ax[1].plot(np.log(ts).diff(1).diff(12).dropna(), label=\"Transformed\")\n",
        "plot_acf(x=np.log(ts).diff(1).diff(12).dropna(),ax=ax[2], lags=60)\n",
        "plot_pacf(x=np.log(ts).diff(1).diff(12).dropna(), ax=ax[3], lags=60)\n",
        "for a in ax.flat:\n",
        "  a.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "a31d5f7a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "*S*easonal *A*uto*R*egressive *I*ntegrated *M*oving *A*verage.\n",
        "\n",
        "$SARIMA(p, d, q)(P, D, Q, s)$, where:\n",
        "\n",
        "- *p* = autoregressive order.\n",
        "- *d* = number of non-seasonal differences.\n",
        "   n of regular differences applied to make it stationary.\n",
        "- *q* = moving average order.\n",
        "- *P* = seasonal autoregressive order.\n",
        "- *D* = seasonal differencing order.\n",
        "    n of seasonal differences.\n",
        "- *Q* = seasonal movin average order.\n",
        "- *s* = length of the seasonal period. Eg.: 12 for monthly data.\n",
        "\n",
        "It is important to remove seasonality with seasonal differencing to make data stationary.\n",
        "\n",
        "$$\n",
        "(1 - \\phi_1 B)(1 - \\Phi_1 B^s)(1 - B)(1 - B^s)y_t = (1 + \\theta_1 B)(1 + \\Theta_1 B^s)\\epsilon_t\n",
        "$$\n",
        "\n",
        "*$y_t$* = observed time series at time t.\n",
        "*B* = backshift operator or lag.\n",
        "*$\\phi_1$* = non-seasonal autoregressive coefficient.\n",
        "*$\\Phi_1$* = seasonal autoregresive coefficient.\n",
        "*$\\theta_1$* = non-seasonal moving average coefficient.\n",
        "*$\\Theta_1$* = seasonal moving average coefficient.\n",
        "*s* = seasonal period.\n",
        "*$\\epsilon_t$* = white noise error term.\n",
        "\n",
        "\n",
        "*ACF* measures the *correlation* between the time series and its lagged values.\n",
        "\n",
        "- *AR* if *decays gradually*.\n",
        "- *MA* if *cuts off sharply*.\n",
        "\n",
        "*PACF* measures the *correlation* between the timne series and its lagged values, * controlling* for the correlations at intermediate lags.\n",
        "\n",
        "- *AR* if *cuts off sharply*.\n",
        "- *MA* if *decays gradually*.\n",
        "\n",
        "* non seasonal -> p, d, q.\n",
        "* seasonal = P, D, Q, s.\n",
        "d and D depends on the number of differentiation I had to do to make the serie stationary.\n",
        "s depends on the data: for monthly data, 12.\n",
        "number of NON SEASONAL components (1,2,3, ...):\n",
        "q depends on ACF.\n",
        "p depends on PACF.\n",
        "number of SEASONAL components (12, 24, ...):\n",
        "Q depends on ACF\n",
        "P depends on PACF"
      ],
      "id": "b8920428"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",
        "\n",
        "p, d, q = 2, 1, 1\n",
        "P, D, Q, s = 2, 1, 1, 12 \n",
        "sarima = SARIMAX( np.log(ts), order=(p,d,q), seasonal_order=(P, D, Q, s))\n",
        "\n",
        "results = sarima.fit()\n",
        "print(results.summary())"
      ],
      "id": "16a8f9c4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, ax = plt.subplots(4, 1, figsize=(12, 10))\n",
        "ax[0].plot(ts_lambda.index, ts_lambda, label=\"Original\")\n",
        "ax[1].plot(ts_lambda.diff(1).diff(12).dropna(), label=\"Transformed\")\n",
        "plot_acf(ts_lambda.diff(1).diff(12).dropna(),ax=ax[2], lags=60)\n",
        "plot_pacf(x=ts_lambda.diff(1).diff(12).dropna(), ax=ax[3], lags=60)\n",
        "for a in ax.flat:\n",
        "  a.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "7550261d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "forecast_steps = 12\n",
        "forecast = results.get_forecast(steps=forecast_steps)\n",
        "\n",
        "forecast_mean = forecast.predicted_mean\n",
        "forecast_ci = forecast.conf_int()\n",
        "\n",
        "forecast_mean_inverse = np.exp(forecast_mean)\n",
        "forecast_ci_inverse = np.exp(forecast_ci)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(15, 10))\n",
        "\n",
        "ax.plot(ts.index[400:], ts[400:], label=\"Original data\")\n",
        "ax.plot(forecast_ci_inverse.index, forecast_ci_inverse, label=\"CI\", color='green', linestyle='dashed')\n",
        "ax.plot(forecast_mean_inverse.index, forecast_mean_inverse, label=\"Prediction\", color='red')\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "b4c85774",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Covid exogenous variable"
      ],
      "id": "97057cef"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "intervention = pd.Series(0, index=ts.index)\n",
        "intervention[\"2020-03\":\"2020-12\"] = 1\n",
        "p, d, q = 2, 1, 1\n",
        "P, D, Q, s = 2, 1, 1, 12 \n",
        "\n",
        "sarima_x = SARIMAX(\n",
        "  np.log(ts),\n",
        "  order=(p,d,q),\n",
        "  seasonal_order=(P, D, Q, s),\n",
        "  exog=intervention\n",
        ")\n",
        "\n",
        "results_x = sarima_x.fit()\n",
        "print(results_x.summary())"
      ],
      "id": "2dee203d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "future_intervention = pd.Series(0, index=range(forecast_steps))\n",
        "\n",
        "forecast_x = results_x.get_forecast(\n",
        "  steps=forecast_steps,\n",
        "  exog=future_intervention\n",
        ")\n",
        "forecast_mean_x = np.exp(forecast_x.predicted_mean)\n",
        "forecast_ci_x = np.exp(forecast_x.conf_int())\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(15, 10))\n",
        "\n",
        "ax.plot(ts.index[400:], ts[400:], label=\"Original data\")\n",
        "ax.plot(forecast_ci_x.index, forecast_ci_x, label=\"CI\", color='green', linestyle='dashed')\n",
        "ax.plot(forecast_mean_x.index, forecast_mean_x, label=\"Prediction\", color='red')\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "971b18a5",
      "execution_count": null,
      "outputs": []
    },
