        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(12, 7))\n",
        "plot_acf(\n",
        "  x=df_log_diff,\n",
        "  ax=ax[0],\n",
        "  lags=40\n",
        ")\n",
        "plot_pacf(\n",
        "  x=df_log_diff,\n",
